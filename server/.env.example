# Configuration base de données
DATABASE_URL="postgresql://username:password@localhost:5432/gestion_rh"

# Configuration JWT
JWT_SECRET="your-secret-key-here"

# Configuration Email (Gmail)
EMAIL_USER="votre-email@gmail.com"
EMAIL_PASSWORD="votre-mot-de-passe-application"

# URL du frontend (pour les liens dans les emails)
FRONTEND_URL="http://localhost:3000"

# URL du backend (pour les liens vers les fichiers uploadés)
BASE_URL="http://localhost:5000"

# Port serveur
PORT=5000

# ============================================
# 💬 GOOGLE PLACES API - Avis Google
# ============================================
# 1. Aller sur https://console.cloud.google.com
# 2. Créer un projet ou en sélectionner un
# 3. Activer "Places API" dans APIs & Services
# 4. Créer une clé API dans Credentials
# 5. (Optionnel) Restreindre la clé à Places API
GOOGLE_PLACES_API_KEY="votre-api-key"

# Place ID du restaurant (trouvé sur Google Maps)
# 1. Chercher le restaurant sur Google Maps
# 2. Cliquer sur le restaurant
# 3. L'URL contient le Place ID après "place/"
# Ou utiliser: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID="ChIJ..."

# ============================================
# 📅 ÉVÉNEMENTS - Gist GitHub
# ============================================
# ID du Gist pour les événements Vincennes (optionnel)
EVENTS_GIST_ID=""

# Clé API Football-Data.org (optionnel, pour matchs)
FOOTBALL_API_KEY=""

# ============================================
# ☁️ CLOUDINARY - Stockage cloud des fichiers
# ============================================
# Créer un compte gratuit sur https://cloudinary.com
# Copier les infos depuis Dashboard > Account Details
CLOUDINARY_CLOUD_NAME="votre-cloud-name"
CLOUDINARY_API_KEY="votre-api-key"
CLOUDINARY_API_SECRET="votre-api-secret"

# ============================================
# 🌤️ Météo & APIs externes
# ============================================
# Ville du restaurant (pour météo et recommandations staffing)
RESTAURANT_CITY="Paris"
